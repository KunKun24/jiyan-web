                        </div>
                    </div>
                </div>
                
                <div id="uploadProgressArea" style="display: none;">
                    <div style="background: #f8f9fa; border: 1px solid #f0f0f0; border-radius: 4px; padding: 16px; margin-bottom: 15px;">
