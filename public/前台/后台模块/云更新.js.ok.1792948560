            <div class="弹窗内部">
                <div id="fileUploadPanel">

                    <div id="dragArea" style="border: 2px dashed #ddd; border-radius: 4px; padding: 30px 20px; text-align: center; cursor: pointer; transition: all 0.2s; margin-bottom: 15px; position: relative;"
                    onmouseover="this.style.borderColor='#28a745'"
                    onmouseout="this.style.borderColor='#ddd'">
                        <div style="font-size: 48px; color: #999; margin-bottom: 12px;">
                            <i class="fas fa-cloud-upload-alt"></i>
                        </div>
                        <div style="font-size: 14px; font-weight: 500; color: #333; margin-bottom: 4px;">拖拽文件到此处 或 点击选择文件</div>
                        <div style="font-size: 12px; color: #999;">支持多库注入,列表几个库就注入几个库</div>
                        <input type="file" id="hiddenFileInput" multiple style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer;">
