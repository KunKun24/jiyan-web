/** V1：功能被管理员关闭时的统一提示（置灰 + 文案） */
function 云更新管理_显示功能关闭(msg) {
    const tbody = document.getElementById('云更新管理_TableBody');
    if (tbody) {
        tbody.innerHTML = '<tr><td colspan="10" style="text-align:center;padding:12vh;color:#8a94a6;">'
            + '<i class="fas fa-lock" style="font-size:44px;display:block;margin-bottom:14px;opacity:.35;"></i>'
            + '<div style="font-size:15px;font-weight:600;color:#4a5568;margin-bottom:6px;">' + (msg || '管理员已关闭云更新功能') + '</div>'
            + '<div style="font-size:12px;">请到「功能开关」面板确认应用/站点是否已开启「云更新」</div>'
            + '</td></tr>';
    }
    ['云更新管理_上传按钮','云更新管理_设置版本按钮','云更新管理_删除按钮'].forEach(function (id) {
        const b = document.getElementById(id);
        if (b) { b.disabled = true; b.style.opacity = '0.45'; b.style.cursor = 'not-allowed'; }
    });
}

//Please do not modify. This file is automatically generated. Thank you.


let 云更新管理_当前页码 = 1;
let 云更新管理_总页数 = 1;
let 云更新管理_每页数量 = 10;
let 云更新管理_当前页数量 = 1;
let 云更新管理_选中的 = new Set();
let 云更新管理_当前搜索关键词 = '';
let 已选文件列表 = [];


let 云更新_更新内容 = '';
async function POSTCUPHP(params = {}) {
    try {
        const IV = 生成随机IV();
        const encryptedData = APP_encryptRequestParams(params, IV);

        
        if (!当前选中的应用ID) {
            return {
                success: false,
                message: '应用ID不能为空'
            };
        }
        
        const requestBody = JSON.stringify({
            developer_username: 开发者UID,
            iv: IV,
            app_id: 当前选中的应用ID,
            data: encryptedData
        });

        const response = await fetch(获取API链接('Cloudupdate.php'), {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json; charset=utf-8',
            },
            body: requestBody
        });
        
        const responseText = await response.text();
        
    
        try {
            const jsonResult = JSON.parse(responseText);
            return jsonResult;
        } catch (e) {
        }
        
        // 如果需要解密
        let decryptedData;
        try {
            // 使用相同的密钥解密
            decryptedData = APP_解密(responseText, IV);
            
        } catch (decryptError) {
            return {
                success: false,
                message: responseText
            };
        }
        
        let result;
        try {
            result = JSON.parse(decryptedData);
        } catch (parseError) {
            try {
                // 尝试清理数据
                const cleanedData = decryptedData.trim();
                result = JSON.parse(cleanedData);
            } catch (cleanError) {
                return {
                    success: false,
                    message: responseText
                };
            }
        }
        
        
        if(!APP_校验响应签名(result)){
        return {
            success: false,
            message: '返回响应不可信,请检查签名状态'
        };
        }
        
        
        return result;
        
    } catch (error) {
        return {
            success: false,
            message: '网络请求失败: ' + error.message
        };
    }
}




function 云更新管理_重置所有选中() {
    云更新管理_选中的.clear();
    const checkboxes = document.querySelectorAll('.云更新管理-选择按钮');
    checkboxes.forEach(checkbox => {
        checkbox.checked = false;
    });
    const selectAllCheckbox = document.getElementById('云更新管理_选择所有_id');
    if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
    }
    
    const 云更新管理_多选功能id = document.getElementById('云更新管理_多选功能id');
    if (云更新管理_多选功能id) {
        云更新管理_多选功能id.style.display = 'none';
    }
}

async function 加载云更新数据(page = 1) {
    if (!开发者UID || !开发者密码) {
        alert('请先登录', false);
        return;
    }
    
    const 云更新管理_加载动画 = document.getElementById('云更新管理_加载动画');
    if (云更新管理_加载动画) 云更新管理_加载动画.style.display = 'flex';
    
    if (!当前选中的应用ID) {
        const tbody = document.getElementById('云更新管理_TableBody');
        if (tbody) {
            tbody.innerHTML = '';
            const emptyRow = document.createElement('tr');
            emptyRow.innerHTML = `
                <td colspan="7" style="text-align: center; padding: 15vh; color: #666;">
                    <i class="fas fa-ban" style="font-size: 48px; margin-bottom: 16px; display: block; opacity: 0.3;"></i>
                    <div style="font-size: 14px;">请先选择目标实例</div>
                    <div style="font-size: 12px; margin-top: 8px;">点击右上角"选择对接实例"开始</div>
                   </td>
            `;
            tbody.appendChild(emptyRow);
        }
        
        if (云更新管理_加载动画) 云更新管理_加载动画.style.display = 'none';
        return;
    }
    
    try {
        const params = {
            action: 'get_file_list',
            password: 开发者密码,
            page: page,
            page_size: 云更新管理_每页数量
        };
                
        if (云更新管理_当前搜索关键词 !== '') {
            params.search = 云更新管理_当前搜索关键词;
        }

        const result = await POSTCUPHP(params);

        if (result.success) {
            const fileList = result.data.file_list || [];
            const paginationData = result.data.pagination;
            
            const capacityInfo = result.data.capacity_info || {};
            
            云更新_更新内容 = result.data.update_content;
            云更新管理_当前页数量 = fileList.length;
            云更新管理_总页数 = paginationData.pages || 1;
            云更新管理_当前页码 = page;
            
            云更新管理_重置所有选中();
            云更新管理_渲染表格(fileList);
            
            云更新管理_更新统计显示数据(paginationData, capacityInfo);
            
            const 云更新管理_版本 = document.getElementById('云更新管理_版本');
            if (云更新管理_版本) {
                云更新管理_版本.textContent = result.data.latest_version;
            }
            const 剩余流量id = document.getElementById('剩余流量id');
            if (剩余流量id) 剩余流量id.textContent = result.data.remaining_times;
            
            if (云更新管理_加载动画) 云更新管理_加载动画.style.display = 'none';
            
        } else {
            var _m = String(result.message || '');
            if (_m.indexOf('管理员已关闭') === 0 || _m.indexOf('该应用已关闭') === 0) {
                云更新管理_显示功能关闭(_m);
                if (云更新管理_加载动画) 云更新管理_加载动画.style.display = 'none';
                return;
            }
            alert('加载文件列表失败: ' + result.message, false);
            if (云更新管理_加载动画) 云更新管理_加载动画.style.display = 'none';
        }
        
    } catch (error) {
        alert('加载文件列表时发生错误: ' + error.message, false);
        if (云更新管理_加载动画) 云更新管理_加载动画.style.display = 'none';
    }
}

function 云更新管理_渲染表格(files) {
    const tbody = document.getElementById('云更新管理_TableBody');
    if (!tbody) return;
    
    tbody.innerHTML = '';
    
    if (!files || files.length === 0) {
        const emptyRow = document.createElement('tr');
        emptyRow.innerHTML = `
            <td colspan="7" style="text-align: center; padding: 15vh; color: #666;">
                <i class="fas fa-folder-open" style="font-size: 48px; margin-bottom: 16px; display: block; opacity: 0.3;"></i>
                <div style="font-size: 14px;">暂无文件</div>
                <div style="font-size: 12px; margin-top: 8px;">点击"上传文件"按钮添加第一个文件</div>
                </td>
        `;
        tbody.appendChild(emptyRow);
        return;
    }

    files.forEach((file, index) => {
        const row = document.createElement('tr');
        const isChecked = 云更新管理_选中的.has(file.id || file.file_id);
        const fileId = file.id || file.file_id || index;
        let fileName = file.file_name;
        const fileSize = formatFileSize(file.file_size);
        const uploadTime = file.upload_time || file.created_at || '未知时间';
        const 消耗次数 = file.download_count || 0;
        
        let fileIcon = '<i class="fas fa-file-code"></i>';
        
        row.innerHTML = `
            <td>
                <input type="checkbox" class="云更新管理-选择按钮" value="${fileId}" ${isChecked ? 'checked' : ''} 
                       onchange="云更新管理_选择按钮处理事件('${fileId}', this.checked)">
                </td>
            <td>
                <span class="file-name">
                    ${fileIcon} ${fileName}
                </span>
                </td>
            <td>
                <span>${uploadTime}</span>
                </td>
                
                
            <td>
                <span class="file-size">${fileSize}</span>
                </td>
                
<td id="隐私模式_区块" style="${是否是隐私模式 ? 'display:none;' : ''} text-align: center;">
    <span class="消耗次数" style="font-weight: 500; color: #ff0000;">
        ${消耗次数} 次
    </span>
</td>



            <td style="text-align: center;">
                <div class="btn-group-compact">
                    <button class="按钮" onclick="云更新_下载文件('${fileId}')" title="下载文件">
                        <i class="fas fa-download"></i> 下载
                    </button>
                    
                    <button class="按钮" onclick="云更新_检查文件('${fileId}')" title="检查文件是否存在">
                        <i class="fas fa-search"></i> 检查
                    </button>
                    
                    <button class="按钮" onclick="deleteSoFile('${fileId}')" title="删除文件">
                        <i class="fas fa-trash"></i> 删除
                    </button>
                </div>
                </td>
        `;
        tbody.appendChild(row);
    });
}

function 云更新管理_搜索关键词() {
    let appSearchTimeout;
    clearTimeout(appSearchTimeout);
    appSearchTimeout = setTimeout(() => {
        const searchKeyword = document.getElementById('云更新管理_搜索框').value.trim();
        云更新管理_当前搜索关键词 = searchKeyword;
        云更新管理_当前页码 = 1;
        加载云更新数据(云更新管理_当前页码);
    }, 500);
}

function 云更新管理_全选所有(checkbox) {
    const checkboxes = document.querySelectorAll('.云更新管理-选择按钮:not(:disabled)');
    const isChecked = checkbox.checked;
    
    const 云更新管理_多选功能id = document.getElementById('云更新管理_多选功能id');
    if (云更新管理_多选功能id) {
        云更新管理_多选功能id.style.display = isChecked ? 'flex' : 'none';
    }
    
    云更新管理_选中的.clear();
    
    checkboxes.forEach(cb => {
        cb.checked = isChecked;
        if (isChecked) {
            云更新管理_选中的.add(cb.value);
        }
    });
}

function 云更新管理_选择按钮处理事件(fileId, isSelected) {
    if (isSelected) {
        云更新管理_选中的.add(fileId);
        const 云更新管理_多选功能id = document.getElementById('云更新管��_多选功能id');
        if (云更新管理_多选功能id) {
            云更新管理_多选功能id.style.display = 'flex';
        }
    } else {
        云更新管理_选中的.delete(fileId);
        if (云更新管理_选中的.size === 0) {
            const 云更新管理_多选功能id = document.getElementById('云更新管理_多选功能id');
            if (云更新管理_多选功能id) {
                云更新管理_多选功能id.style.display = 'none';
            }
        }
    }
    
    const allCheckboxes = document.querySelectorAll('.云更新管理-选择按钮');
    const checkedCheckboxes = document.querySelectorAll('.云更新管理-选择按钮:checked');
    const selectAllCheckbox = document.getElementById('云更新管理_选择所有_id');
    
    if (selectAllCheckbox) {
        if (allCheckboxes.length > 0 && checkedCheckboxes.length === 云更新管理_当前页数量) {
            selectAllCheckbox.checked = true;
        } else {
            selectAllCheckbox.checked = false;
        }
    }
}

function 云更新管理_加载上一页() {
    let 变化后的页面 = 云更新管理_当前页码 - 1;
    if (变化后的页面 < 1 || 变化后的页面 > 云更新管理_总页数) {
        alert("已是第一页");
        return;
    }
    加载云更新数据(变化后的页面);
}

function 云更新管理_加载下一页() {
    let 变化后的页面 = 云更新管理_当前页码 + 1;
    if (变化后的页面 < 1 || 变化后的页面 > 云更新管理_总页数) {
        alert("已是最后一页");
        return;
    }
    加载云更新数据(变化后的页面);
}

function 云更新管理_加载首页() {
    加载云更新数据(1);
}

function 云更新管理_加载尾页() {
    加载云更新数据(云更新管理_总页数);
}

function 云更新管理_更新统计显示数据(pagination, capacityInfo) {
    const 云更新管理_总记录数 = document.getElementById('云更新管理_总记录数');
    云更新管理_总记录数.textContent = pagination.total;

    // 注意：用量为 0 时 used_percentage === 0，不能用真值判断（否则永远不显示 0%）
    const 云更新管理_统计_容量使用 = document.getElementById('云更新管理_统计_容量使用');
    if (云更新管理_统计_容量使用 && capacityInfo.used_percentage !== undefined && capacityInfo.used_percentage !== null) {
        云更新管理_统计_容量使用.textContent = `${capacityInfo.used_percentage}%`;
    }

    const 云更新管理_统计_总容量 = document.getElementById('云更新管理_统计_总容量');
    if (云更新管理_统计_总容量 && capacityInfo.max_size_mb !== undefined && capacityInfo.max_size_mb !== null) {
        云更新管理_统计_总容量.textContent = `${capacityInfo.max_size_mb}MB`;
    }
    
    const titleTextEl = document.getElementById('云更新管理_码页信息');
    titleTextEl.textContent = `第${云更新管理_当前页码}/${云更新管理_总页数}页`;
    const titleTextE2 = document.getElementById('云更新管理_当前码页');
    titleTextE2.textContent = `${云更新管理_当前页码}`;
}


