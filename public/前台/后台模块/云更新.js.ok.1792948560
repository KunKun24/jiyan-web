    setTimeout(() => {
            初始化上传方式();

    }, 50);
}

function 初始化上传方式() {
    const 拖拽区域 = document.getElementById('dragArea');
    const 隐藏文件输入 = document.getElementById('hiddenFileInput');
    
    if (拖拽区域) {
        初始化拖拽区域();
    }
    
    if (隐藏文件输入) {
        隐藏文件输入.addEventListener('change', (e) => {
            if (e.target.files && e.target.files.length > 0) {
                const files = Array.from(e.target.files);
                处理文件选择(files);
                e.target.value = '';
            }
        });
    }
}

function 初始化拖拽区域() {
    const 拖拽区域 = document.getElementById('dragArea');
    const 隐藏文件输入 = document.getElementById('hiddenFileInput');
    
    if (!拖拽区域) return;
    
    拖拽区域.addEventListener('dragover', (e) => {
        e.preventDefault();
        拖拽区域.classList.add('dragover');
    });
    
    拖拽区域.addEventListener('dragleave', (e) => {
        e.preventDefault();
        拖拽区域.classList.remove('dragover');
    });
    
    拖拽区域.addEventListener('drop', (e) => {
        e.preventDefault();
        e.stopPropagation();
        拖拽区域.classList.remove('dragover');
        
        if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {
            const files = Array.from(e.dataTransfer.files);
            处理文件选择(files);
        }
    });
    
    拖拽区域.addEventListener('click', (e) => {
        if (e.target !== 隐藏文件输入 && !隐藏文件输入.contains(e.target)) {
            if (隐藏文件输入) {
                隐藏文件输入.click();
            }
        }
    });
}

function 选择更多文件() {
    const 文件输入 = document.createElement('input');
    文件输入.type = 'file';
    文件输入.accept = '';
    文件输入.multiple = true;
    文件输入.style.display = 'none';
    
    document.body.appendChild(文件输入);
    
    setTimeout(() => {
        文件输入.click();
    }, 100);
    
    文件输入.addEventListener('change', (e) => {
        if (e.target.files && e.target.files.length > 0) {
            const files = Array.from(e.target.files);
            处理文件选择(files);
        }
        
        setTimeout(() => {
            if (document.body.contains(文件输入)) {
                document.body.removeChild(文件输入);
            }
        }, 1000);
    });
    
    文件输入.addEventListener('click', (e) => {
        e.stopPropagation();
    });
}

function 处理文件选择(files) {
    const 有效文件 = [];
    const 错误信息 = [];
    
    files.forEach(file => {
        if (!/^[^.]*$|\.(so|bin|dat)$/i.test(file.name)) {
            错误信息.push(`${file.name}: 不是.so文件`);
            return;
        }
        
        if (file.size > 52 * 1024 * 1024) {
            错误信息.push(`${file.name}: 文件超过30MB限制`);
            return;
        }
        
        const 重复文件 = 已选文件列表.find(f => f.name === file.name && f.size === file.size);
        if (重复文件) {
            错误信息.push(`${file.name}: 文件已存在`);
            return;
        }
        
        有效文件.push(file);
    });
    
    if (有效文件.length > 0) {
        已选文件列表.push(...有效文件);
        更新文件列表显示();
        
        const 拖拽区域 = document.getElementById('dragArea');
        if (拖拽区域) 拖拽区域.style.display = 'none';
    }
    
    if (错误信息.length > 0) {
        alert('以下文件不符合要求：\n' + 错误信息.join('\n'), 'warning');
    }
}

function 更新文件列表显示() {
    const 文件列表区域 = document.getElementById('fileListArea');
    const 文件列表容器 = document.getElementById('fileListContainer');
    const 已选文件数 = document.getElementById('selectedCount');
    const 上传按钮 = document.getElementById('uploadBtn');
    
    if (!文件列表区域 || !文件列表容器) return;
    
    if (已选文件列表.length === 0) {
        文件列表区域.style.display = 'none';
        if (上传按钮) 上传按钮.disabled = true;
        const 拖拽区域 = document.getElementById('dragArea');
        if (拖拽区域) 拖拽区域.style.display = 'block';
        return;
    }
    
    文件列表区域.style.display = 'block';
    if (上传按钮) {
        上传按钮.disabled = false;
    }
    
    if (已选文件数) 已选文件数.textContent = 已选文件列表.length;
    
    文件列表容器.innerHTML = 已选文件列表.map((file, index) => `
        <div style="display: flex; align-items: center; padding: 10px 12px; background: white; border-radius: 4px; margin-bottom: 8px;">
            <div style="font-size: 16px; color: #28a745; width: 24px; flex-shrink: 0;">
                <i class="fas fa-file-code"></i>
            </div>
            <div style="flex: 1; min-width: 0; margin-right: 10px;">
                <div style="font-size: 13px; color: #333; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${file.name}</div>
                <div style="font-size: 11px; color: #666;">${formatFileSize(file.size)}</div>
            </div>
            <button onclick="从列表移除文件(${index})" style="background: none; border: none; color: #999; cursor: pointer; padding: 4px; font-size: 14px;"
            onmouseover="this.style.color='#ff4d4f'"
            onmouseout="this.style.color='#999'">
                <i class="fas fa-times"></i>
            </button>
        </div>
    `).join('');
}

function 从列表移除文件(index) {
    if (index >= 0 && index < 已选文件列表.length) {
        已选文件列表.splice(index, 1);
        更新文件列表显示();
    }
}

function 关闭上传弹窗() {
    const 弹窗 = document.getElementById('uploadModalOverlay');
    if (弹窗) {
        弹窗.remove();
    }
    已选文件列表 = [];
}

let 当前上传队列 = [];
let 上传成功数 = 0;
let 上传失败数 = 0;

async function 云更新_开始上传() {
    await 开始上传文件();
}

async function 开始上传文件() {
    if (已选文件列表.length === 0) {
        alert('请选择要上传的文件', 'warning');
        return;
    }
    
    
    
    const 上传进度区 = document.getElementById('uploadProgressArea');
    const 文件列表区域 = document.getElementById('fileListArea');
    const 文件上传面板 = document.getElementById('fileUploadPanel');
    const 上传按钮 = document.getElementById('uploadBtn');
    
    if (上传进度区) 上传进度区.style.display = 'block';
    if (文件列表区域) 文件列表区域.style.display = 'none';
    if (文件上传面板) 文件上传面板.style.display = 'none';
    if (上传按钮) 上传按钮.disabled = true;
    
    上传成功数 = 0;
    上传失败数 = 0;
    const 失败详情列表 = [];
    窗口上传结果详情 = [];
    
    当前上传队列 = 已选文件列表.map((file, index) => ({
        file, index, status: 'pending', progress: 0, speed: '0 KB/s', remaining: '计算中', xhr: null, errorMessage: '', responseData: null
    }));
    
    初始化上传进度显示(当前上传队列);
    
    const 并发数 = 3;
    let 正在上传数 = 0;
    
    async function 上传单个文件(queueItem) {
        if (queueItem.status !== 'pending') return;
        
        正在上传数++;
        queueItem.status = 'uploading';
        更新文件上传状态(queueItem.index, 'uploading');
        
        try {
            const formData = new FormData();
            formData.append('action', 'upload_so');
            formData.append('developer_username', 开发者UID);
            formData.append('password', 开发者密码);
            formData.append('token', 开发者Token);
            formData.append('app_id', 当前选中的应用ID);
            formData.append('so_file', queueItem.file);
            
            const xhr = new XMLHttpRequest();
            queueItem.xhr = xhr;
            
            const 上传开始时间 = Date.now();
            const 总文件大小 = queueItem.file.size;
            let 最后更新时间 = 上传开始时间;
            let 最后上传字节 = 0;
            let 最后速度 = 0;
            
            const uploadResult = await new Promise((resolve, reject) => {
                xhr.upload.addEventListener('progress', (event) => {
                    if (event.lengthComputable) {
                        const 当前时间 = Date.now();
                        const 已上传字节 = event.loaded;
                        const 进度 = (已上传字节 / 总文件大小) * 100;
                        queueItem.progress = 进度;
                        
                        if (最后更新时间 > 0) {
                            const 时间差秒 = Math.max(0.1, (当前时间 - 最后更新时间) / 1000);
                            const 字节差 = 已上传字节 - 最后上传字节;
                            
                            if (字节差 > 0) {
                                const 当前瞬时速度 = 字节差 / 时间差秒;
                                最后速度 = 最后速度 === 0 ? 当前瞬时速度 : (最后速度 * 0.7 + 当前瞬时速度 * 0.3);
                                
                                if (最后速度 < 1024) queueItem.speed = `${Math.round(最后速度)} B/s`;
                                else if (最后速度 < 1024 * 1024) queueItem.speed = `${(最后速度 / 1024).toFixed(1)} KB/s`;
                                else queueItem.speed = `${(最后速度 / (1024 * 1024)).toFixed(1)} MB/s`;
                                
                                const 剩余字节 = 总文件大小 - 已上传字节;
                                if (最后速度 > 0) {
                                    const 剩余时间秒 = 剩余字节 / 最后速度;
                                    if (剩余时间秒 < 1) queueItem.remaining = '<1秒';
                                    else if (剩余时间秒 < 60) queueItem.remaining = `${Math.round(剩余时间秒)}秒`;
                                    else queueItem.remaining = `${Math.floor(剩余时间秒 / 60)}分${Math.round(剩余时间秒 % 60)}秒`;
                                }
                            }
                        }
                        
                        最后更新时间 = 当前时间;
                        最后上传字节 = 已上传字节;
                        更新文件上传进度(queueItem.index, 进度, queueItem.speed, queueItem.remaining);
                        更新总进度(当前上传队列);
                    }
                });
                
                xhr.onload = function() {
                    try {
                        const 结果 = JSON.parse(xhr.responseText);
                        if (结果.success) {
                            queueItem.responseData = 结果.data;
                            resolve(结果);
                        } else {
                            reject(new Error(结果.message || '服务器返回失败'));
                        }
                    } catch (e) {
                        reject(new Error('解析服务器响应失败'));
                    }
                };
                
                xhr.onerror = function() {
                    reject(new Error('网络连接错误'));
                };
                
                xhr.ontimeout = function() {
                    reject(new Error('请求超时'));
                };
                
                xhr.open('POST', 获取API链接('Cloudupdate_上传.php'));
                xhr.timeout = 300000;
                xhr.send(formData);
            });
            
            queueItem.status = 'success';
            queueItem.errorMessage = '';
            上传成功数++;
            
            窗口上传结果详情.push({
                fileName: queueItem.file.name,
                status: 'success',
                message: '上传成功',
                fileSize: formatFileSize(queueItem.file.size),
                responseData: queueItem.responseData
            });
            
            更新文件上传状态(queueItem.index, 'success');
            
        } catch (错误) {
            queueItem.status = false;
            queueItem.errorMessage = 错误.message;
            上传失败数++;
            
            窗口上传结果详情.push({
                fileName: queueItem.file.name,
                status: false,
                message: queueItem.errorMessage,
                fileSize: formatFileSize(queueItem.file.size)
            });
            
            更新文件上传状态(queueItem.index, false, queueItem.errorMessage);
        } finally {
            正在上传数--;
            更新总进度(当前上传队列);
            继续上传();
        }
    }
    
    function 继续上传() {
        const 等待文件 = 当前上传队列.filter(item => item.status === 'pending');
        
        if (等待文件.length === 0 && 正在上传数 === 0) {
            setTimeout(() => {
                上传完成处理(上传成功数, 上传失败数);
            }, 500);
            return;
        }
        
        while (正在上传数 < 并发数 && 等待文件.length > 0) {
            const nextFile = 等待文件.shift();
            上传单个文件(nextFile);
        }
    }
    
    for (let i = 0; i < Math.min(并发数, 当前上传队列.length); i++) {
        继续上传();
    }
}

function 初始化上传进度显示(上传队列) {
    const 文件上传列表 = document.getElementById('fileUploadList');
    const 总文件数 = document.getElementById('totalCount');
    
    if (总文件数) 总文件数.textContent = 上传队列.length;
    
    if (文件上传列表) {
        文件上传列表.innerHTML = 上传队列.map((item, index) => `
            <div style="background: white; border-radius: 4px; padding: 12px; border: 1px solid #f0f0f0;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                    <div id="upload-file-name-${index}" style="font-size: 13px; color: #333; font-weight: 500; flex: 1; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${item.file.name}</div>
                    <div id="upload-file-status-${index}" class="upload-file-status pending" style="font-size: 11px; padding: 2px 8px; border-radius: 20px; background: #f0f0f0; color: #666;">等待中</div>
                </div>
                <div style="height: 4px; background: #f0f0f0; border-radius: 2px; overflow: hidden; margin-bottom: 6px;">
                    <div id="upload-progress-${index}" style="height: 100%; background: #28a745; width: 0%; transition: width 0.3s;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: 11px; color: #666;">
                    <div id="upload-speed-${index}">0 KB/s</div>
                    <div id="upload-remaining-${index}">计算中</div>
                </div>
            </div>
        `).join('');
    }
}

function 更新文件上传状态(index, status, errorMessage = '') {
    const 状态元素 = document.getElementById(`upload-file-status-${index}`);
    if (状态元素) {
        const 状态文本 = { pending: '等待中', uploading: '上传中', success: '✓ 已完成', error: '✗ 失败' };
        状态元素.textContent = 状态文本[status] || status;
        状态元素.className = `upload-file-status ${status}`;
        
        if (status === 'success') {
            状态元素.style.background = '#d4edda';
            状态元素.style.color = '#28a745';
        } else if (status === false) {
            状态元素.style.background = '#f8d7da';
            状态元素.style.color = '#dc3545';
            if (errorMessage) {
                const 文件名元素 = document.getElementById(`upload-file-name-${index}`);
                if (文件名元素 && !文件名元素.innerHTML.includes('错误：')) {
                    文件名元素.style.color = '#dc3545';
                }
            }
        } else if (status === 'uploading') {
            状态元素.style.background = '#fff3cd';
            状态元素.style.color = '#ffc107';
        } else {
            状态元素.style.background = '#f0f0f0';
            状态元素.style.color = '#666';
        }
    }
}

function 更新文件上传进度(index, progress, speed, remaining) {
    const 进度条 = document.getElementById(`upload-progress-${index}`);
    const 速度显示 = document.getElementById(`upload-speed-${index}`);
    const 剩余时间显示 = document.getElementById(`upload-remaining-${index}`);
    
    if (进度条) 进度条.style.width = `${progress}%`;
    if (速度显示) 速度显示.textContent = speed;
    if (剩余时间显示) 剩余时间显示.textContent = remaining;
}

function 更新总进度(上传队列) {
    const 总进度条 = document.getElementById('overallProgressBar');
    const 总进度文本 = document.getElementById('overallProgressText');
    const 已完成数 = document.getElementById('completedCount');
    
    if (!上传队列 || 上传队列.length === 0) return;
    
    const 已完成文件 = 上传队列.filter(item => item.status === 'success' || item.status === false);
    const 总进度 = Math.round((已完成文件.length / 上传队列.length) * 100);
    
    if (总进度条) 总进度条.style.width = `${总进度}%`;
    if (总进度文本) 总进度文本.textContent = `${总进度}%`;
    if (已完成数) 已完成数.textContent = 已完成文件.length;
}

function 上传完成处理(成功数, 失败数) {
    const 上传按钮 = document.getElementById('uploadBtn');
    
    if (上传按钮) {
        上传按钮.disabled = false;
        上传按钮.onclick = function() {
            关闭上传弹窗();
            加载云更新数据(云更新管理_当前页码);
        };
    }
    
    setTimeout(() => {
        if (document.getElementById('uploadModalOverlay')) {
            关闭上传弹窗();
            加载云更新数据(云更新管理_当前页码);
            显示上传详细结果弹窗(成功数, 失败数);
        }
    }, 1000);
}

function 显示上传详细结果弹窗(成功数, 失败数) {
    const existingModal = document.getElementById('uploadResultModal');
    if (existingModal) existingModal.remove();
    
    const modal = document.createElement('div');
    modal.id = 'uploadResultModal';
    modal.classList.add('弹窗遮罩');
    
    const 成功文件 = 窗口上传结果详情.filter(item => item.status === 'success');
    const 失败文件 = 窗口上传结果详情.filter(item => item.status === false);
    
    modal.innerHTML = `
        <div class="弹窗背景">
            <div class="弹窗头部">
                <div class="弹窗头部文字">
                    <i class="fas fa-chart-bar" style="color: ${失败数 > 0 ? '#28a745' : '#28a745'};"></i>
                    <h4>上传结果详情</h4>
                </div>
                <button onclick="关闭上传结果弹窗()" class="弹窗头部关闭按钮">&times;</button>
            </div>
            
            <div class="弹窗内部">
                ${成功文件.length > 0 ? `
                <div style="margin-bottom: 20px;">
                    <div style="font-size: 14px; font-weight: bold; color: #28a745; margin-bottom: 10px; padding-bottom: 5px; border-bottom: 2px solid #28a745;">
                        <i class="fas fa-check-circle"></i> 成功上传 (${成功文件.length})
                    </div>
                    <div style="max-height: 250px; overflow-y: auto; background: #f9f9f9; border-radius: 8px; padding: 10px;">
                        ${成功文件.map((item, idx) => `
                            <div style="padding: 8px 10px; border-bottom: 1px solid #eee; display: flex; align-items: center; gap: 10px;">
                                <i class="fas fa-file-code" style="color: #28a745; font-size: 14px;"></i>
                                <div style="flex: 1;">
                                    <div style="font-size: 13px; font-weight: 500; color: #333;">${escapeHtml(item.fileName)}</div>
                                    <div style="font-size: 11px; color: #666;">${item.fileSize}</div>
                                </div>
                                <div style="font-size: 11px; color: #28a745; background: #d4edda; padding: 2px 8px; border-radius: 20px;">✓ 成功</div>
                            </div>
                        `).join('')}
                    </div>
                </div>
                ` : ''}
                
                ${失败文件.length > 0 ? `
                <div>
                    <div style="font-size: 14px; font-weight: bold; color: #dc3545; margin-bottom: 10px; padding-bottom: 5px; border-bottom: 2px solid #dc3545;">
                        <i class="fas fa-times-circle"></i> 上传失败 (${失败文件.length})
                    </div>
                    <div style="max-height: 200px; overflow-y: auto; background: #f9f9f9; border-radius: 8px; padding: 10px;">
                        ${失败文件.map((item, idx) => `
                            <div style="padding: 8px 10px; border-bottom: 1px solid #eee; margin-bottom: 8px;">
                                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 4px;">
                                    <i class="fas fa-file-code" style="color: #dc3545; font-size: 14px;"></i>
                                    <div style="flex: 1;">
                                        <div style="font-size: 13px; font-weight: 500; color: #333;">${escapeHtml(item.fileName)}</div>
                                        <div style="font-size: 11px; color: #666;">${item.fileSize}</div>
                                    </div>
                                    <div style="font-size: 11px; color: #dc3545; background: #f8d7da; padding: 2px 8px; border-radius: 20px;">✗ 失败</div>
                                </div>
                                <div style="font-size: 11px; color: #dc3545; background: #fff5f5; padding: 6px 10px; border-radius: 4px; margin-top: 5px;">
                                    <i class="fas fa-exclamation-triangle"></i> ${escapeHtml(item.message)}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
                ` : ''}
            </div>
            
            <div class="弹窗底部">
                <button onclick="关闭上传结果弹窗()" 
                    style="padding: 8px 24px; background: #28a745; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s;"
                    onmouseover="this.style.backgroundColor='#34ce57'; this.style.transform='translateY(-1px)'" 
                    onmouseout="this.style.backgroundColor='#28a745'; this.style.transform='translateY(0)'">
                    关闭
                </button>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    modal.addEventListener('click', function(e) {
        if (e.target === modal) {
            关闭上传结果弹窗();
        }
    });
}

function 关闭上传结果弹窗() {
    const modal = document.getElementById('uploadResultModal');
    if (modal) modal.remove();
    window.上传结果详情 = null;
}

function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
}

async function 云更新_下载文件(fileId) {
    if (!当前选中的应用ID) {
        alert('请先选择应用', 'warning');
        return;
    }
    
    try {
        const params = {
            action: 'get_download_url',
            
            password: 开发者密码,
            file_id: fileId,
            device_id: 开发者UID
        };
        const result = await POSTCUPHP(params);
        if (result.success) {
            let 下载链接 = result.data.download_url;
            window.location.href = 下载链接;
            alert('下载成功', 'success');
        } else {
            alert('下载失败: ' + result.message, false);
        }
        
    } catch (error) {
        alert('下载失败: ' + error.message, false);
    }
}

async function 云更新_检查文件(fileId) {
    if (!当前选中的应用ID) {
        alert('请先选择应用', 'warning');
        return;
    }
    
    等待动画('正在获取库信息...如果存储位置在第三方还需等待调用接口,如果等待时间过长请耐心等待');
    try {
        const params = {
            action: 'check_file_exists',
            password: 开发者密码,
            file_id: fileId
        };
        const result = await POSTCUPHP(params);
        
        删除等待动画();
        if (result.success) {
            const 文件存在 = result.data.file_exists;
            const 文件名 = result.data.file_name;
            
            // 创建弹窗
            const existingModal = document.getElementById('fileCheckModal');
            if (existingModal) existingModal.remove();
            
            const modal = document.createElement('div');
            modal.id = 'fileCheckModal';
            modal.classList.add('弹窗遮罩');
            
            const 状态图标 = 文件存在 ? '✓': '✗';
            const 状态颜色 = 文件存在 ? '#28a745' : '#dc3545';
            const 状态文本 = 文件存在 ? '文件存在' : '文件不存在';
            const 状态描述 = 文件存在 ? '物理文件正常，可正常下载' : '物理文件已丢失，建议重新上传';
            
            modal.innerHTML = `
                <div class="弹窗背景" style="max-width: 450px;">
                    <div class="弹窗头部">
                        <div class="弹窗头部文字">
                            <i class="fas fa-search" style="color: ${状态颜色};"></i>
                            <h4>文件检查结果</h4>
                        </div>
                        <button onclick="关闭文件检查弹窗()" class="弹窗头部关闭按钮">&times;</button>
                    </div>
                    
                    <div class="弹窗内部">
                        <div style="text-align: center; padding: 20px 0;">
                            <div style="font-size: 64px; margin-bottom: 16px; color: ${状态颜色};">${状态图标}</div>
                            <div style="font-size: 20px; font-weight: bold; color: ${状态颜色}; margin-bottom: 20px;">${状态文本}</div>
                            
                            <div style="background: #f8f9fa; border-radius: 12px; padding: 16px; text-align: left; margin-top: 10px;">
                                <div style="display: flex; align-items: center; padding: 8px 0; border-bottom: 1px solid #eee;">
                                    <div style="width: 100px; font-size: 13px; color: #666;">文件名</div>
                                    <div style="flex: 1; font-size: 13px; color: #333; font-weight: 500; word-break: break-all;">${escapeHtml(文件名)}</div>
                                </div>
                                <div style="display: flex; align-items: center; padding: 8px 0;">
                                    <div style="width: 100px; font-size: 13px; color: #666;">文件状态</div>
                                    <div style="flex: 1;">
                                        <span style="display: inline-block; padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 500; background: ${状态颜色}20; color: ${状态颜色};">
                                            ${状态描述}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="弹窗底部">
                        <button onclick="关闭文件检查弹窗()" 
                            style="padding: 8px 24px; background: ${状态颜色}; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s;"
                            onmouseover="this.style.backgroundColor='${文件存在 ? '#34ce57' : '#e63946'}'; this.style.transform='translateY(-1px)'" 
                            onmouseout="this.style.backgroundColor='${状态颜色}'; this.style.transform='translateY(0)'">
                            确定
                        </button>
                    </div>
                </div>
            `;
            
            document.body.appendChild(modal);
            
            modal.addEventListener('click', function(e) {
                if (e.target === modal) {
                    关闭文件检查弹窗();
                }
            });
            
        } else {
            alert('检查失败: ' + result.message, false);
        }
        
    } catch (error) {
        删除等待动画();
        alert('检查失败: ' + error.message, false);
    }
}

function 关闭文件检查弹窗() {
    const modal = document.getElementById('fileCheckModal');
    if (modal) modal.remove();
}

async function deleteSoFile(fileId) {
    if (!confirm('确定要删除这个SO文件吗？此操作不可撤销.')) return;
    
    if (!当前选中的应用ID) {
        alert('请先选择应用', 'warning');
        return;
    }
    
    try {
        const params = {
            action: 'delete_so',
            password: 开发者密码,
            file_id: fileId
        };
        
        const result = await POSTCUPHP(params);
        
        if (result.success) {
            alert('SO文件删除成功！', 'success');
            加载云更新数据(云更新管理_当前页码);
        } else {
            alert('删除失败: ' + result.message, false);
        }
        
    } catch (error) {
        alert('删除失败: ' + error.message, false);
    }
}

async function 云更新管理_选中功能_删除() {
    if (!confirm('确定要删除所有选中的SO文件吗？此操作不可撤销！')) return;
    
    const 选中的格式化 = Array.from(云更新管理_选中的);
    if (选中的格式化.length === 0) {
        alert('没有选中的项', false);
        return;
    }
    
    let 成功数 = 0;
    let 失败数 = 0;
    
    try {
        for (const fileId of 云更新管理_选中的) {
            try {
                const params = {
                    action: 'delete_so',
            password: 开发者密码,
                    file_id: fileId
                };
                
                const result = await POSTCUPHP(params);
                
                if (result.success) {
                    成功数++;
                } else {
                    失败数++;
                }
            } catch (e) {
                失败数++;
            }
        }
        
        alert(`删除操作完成！成功：${成功数},失败：${失败数}`);
        加载云更新数据(云更新管理_当前页码);
        
    } catch (error) {
        alert('删除过程中出现错误: ' + error.message, false);
    }
}
    async function 云更新设置版本() {
    if(!当前选中的应用名称){
        alert("没有有效的应用信息");
        return;
    }
    
    let 当前版本元素 = document.getElementById('云更新管理_版本');
    let 当前版本 = 当前版本元素 ? 当前版本元素.textContent : '1.0.0';
    
    const existingModal = document.querySelector('.simple-version-settings-modal');
    if (existingModal) existingModal.remove();
    
    const modal = document.createElement('div');
    modal.className = 'simple-version-settings-modal 弹窗遮罩';
    modal.innerHTML = `
        <div class="弹窗背景">
            <div class="弹窗头部">
                <div class="弹窗头部文字">
                    <i class="fas fa-code-branch" style="color: #007bff;"></i>
                    <h4>版本设置</h4>
                </div>
                <button onclick="this.closest('.simple-version-settings-modal').remove()" 
                        class="弹窗头部关闭按钮">&times;</button>
            </div>
            <div class="弹窗内部">
                <div style="margin-bottom:15px;">
                    <div style="font-size:13px;font-weight:500;color:#333;margin-bottom:5px;">最新版本号</div>
                    <input type="text" id="versionInput" value="${当前版本}" 
                           placeholder="请输入版本号" style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:4px;font-size:14px;box-sizing:border-box;">
                </div>
                <div style="margin-bottom:15px;">
                    <div style="font-size:13px;font-weight:500;color:#333;margin-bottom:5px;">更新内容(可留空)</div>
                    <textarea id="updateContentInput" rows="4" placeholder="请输入更新内容描述"
                              style="width:100%;padding:10px 12px;border:1px solid #ddd;border-radius:4px;font-size:14px;box-sizing:border-box;resize:vertical;font-family:inherit;height:200px;">${云更新_更新内容 || ''}</textarea>
                </div>
            </div>
            <div class="弹窗底部">
                <button onclick="this.closest('.simple-version-settings-modal').remove()" 
                        style="padding:8px 16px;background:#f8f9fa;color:#666;border:1px solid #ddd;border-radius:20px;cursor:pointer;font-size:13px;">取消</button>
                <button onclick="云更新保存版本()" 
                        style="padding:8px 16px;background:#007bff;color:white;border:none;border-radius:20px;cursor:pointer;font-size:13px;font-weight:500;">
                    <i class="fas fa-save" style="margin-right:4px;"></i>保存
                </button>
            </div>
        </div>
    `;
    document.body.appendChild(modal);
}




async function 云更新保存版本() {
    const 版本 = document.getElementById('versionInput').value.trim();
    const 内容 = document.getElementById('updateContentInput').value.trim();
    if (!版本) return alert('请输入版本号');
    
    try {
        const result = await POSTCUPHP({
            action: 'set_version',
            password: 开发者密码,
            latest_version: 版本,
            update_content: 内容
        });
        
        if(result.success){
            云更新_更新内容 = 内容;
            document.getElementById('云更新管理_版本').textContent = 版本;
        }
        alert(result.message, result.success);
        document.querySelector('.simple-version-settings-modal')?.remove();

    } catch (error) {
        alert(error.message);
        document.querySelector('.simple-version-settings-modal')?.remove();
    }
}



function formatFileSize(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

let 窗口上传结果详情 = [];

async function 云更新_充值流量() {
    if (!当前选中的应用ID) {
        alert('请先选择应用');
        return;
    }
    
    const existingModal = document.getElementById('datatopuppopupModal');
    if (existingModal) existingModal.remove();
    
    const modal = document.createElement('div');
    modal.id = 'datatopuppopupModal';
    modal.classList.add('弹窗遮罩');

    const 流量套餐 = [
        { id: 1, name: '100次', price: 1.0 },
        { id: 2, name: '1000次', price: 8.0},
        { id: 3, name: '3000次', price: 16.0},
        { id: 4, name: '1万次', price: 40.00 }
    ];
    
    modal.innerHTML = `
        <div class="弹窗背景">
            <div class="弹窗头部">
                <div class="弹窗头部文字">
                    <i class="fas fa-bolt" style="color: #0b5e8a;"></i>
                    <h4>充值次数</h4>
                </div>
                <button onclick="closedatatopuppopupModal()" class="弹窗头部关闭按钮">&times;</button>
            </div>
            
            <div class="弹窗内部">
                <div style="font-size: 13px; font-weight: 500; color: #333; margin-bottom: 10px;">选择次数包：</div>
                <div style="margin-bottom: 15px;">
                    ${流量套餐.map((item, index) => `
                        <div onclick="selectTrafficPackage(${item.id}, '${item.name}', ${item.price})" 
                             id="trafficPackage${index}"
                             style="border: 1px solid #ddd; border-radius: 20px; padding: 15px 15px; margin-bottom: 8px; cursor: pointer; transition: all 0.2s;"
                             onmouseover="this.style.borderColor='#0b5e8a'"
                             onmouseout="if(!this.classList.contains('active')) this.style.borderColor='#ddd'">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div>
                                    <div style="font-weight: bold; color: #333;">${item.name}</div>
                                </div>
                                <div style="text-align: right;">
                                    <div style="font-size: 18px; font-weight: bold; color: #0b5e8a;">¥${item.price}</div>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                </div>
            </div>   
            <div class='弹窗底部'>
                <button onclick="closedatatopuppopupModal()" style="padding: 8px 16px; background: #f8f9fa; color: #666; border: 1px solid #ddd; border-radius: 20px; cursor: pointer; font-size: 13px; transition: all 0.2s;"
                onmouseover="this.style.backgroundColor='#e9ecef'; this.style.borderColor='#ccc'"
                onmouseout="this.style.backgroundColor='#f8f9fa'; this.style.borderColor='#ddd'">取消</button>
                <button onclick="confirmTrafficPurchase()" id="confirmTrafficBtn" style="padding: 8px 16px; background: #0b5e8a; color: white; border: none; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: 500; transition: all 0.2s;"
                onmouseover="this.style.backgroundColor='#0c6c9c'; this.style.transform='translateY(-1px)'"
                onmouseout="this.style.backgroundColor='#0b5e8a'; this.style.transform='translateY(0)'">
                    <i class="fas fa-check-circle"></i> 确认充值
                </button>
            </div>
        </div>
    `;
    
    document.body.appendChild(modal);
    
    const firstPackage = 流量套餐[0];
    selectTrafficPackage(firstPackage.id, firstPackage.name, firstPackage.price);
}

function closedatatopuppopupModal() {
    const modal = document.getElementById('datatopuppopupModal');
    if (modal) modal.remove();
}

function selectTrafficPackage(packageId, packageName, price) {
    window.当前选中流量套餐 = { id: packageId, name: packageName, price: price };
    
    for (let i = 0; i < 5; i++) {
        const option = document.getElementById(`trafficPackage${i}`);
        if (option) {
            option.style.borderColor = '#ddd';
            option.style.background = 'white';
            option.classList.remove('active');
        }
    }
    
    const index = packageId - 1;
    const selected = document.getElementById(`trafficPackage${index}`);
    if (selected) {
        selected.style.borderColor = '#0b5e8a';
        selected.style.background = '#e6f3ff';
        selected.classList.add('active');
    }
    
    const confirmBtn = document.getElementById('confirmTrafficBtn');
    if (confirmBtn) {
        confirmBtn.disabled = false;
        confirmBtn.style.background = '#0b5e8a';
    }
}

async function confirmTrafficPurchase() {
    const selectedPackage = window.当前选中流量套餐;
    
    if (!selectedPackage) {
        alert('请先选择流量套餐');
        return;
    }
    
    if (!confirm(`确认充值 ${selectedPackage.name}？`)) return;
    
    try {
        const params = {
            action: 'recharge_traffic',
            password: 开发者密码,
            app_id: 当前选中的应用ID,
            package_id: selectedPackage.id
        };
        
        // 云更新通道统一走 Cloudupdate.php（协议 B：应用加密 + 应用签名）
        const result = await POSTCUPHP(params);
        
        if (result.success) {
            alert(result.message, 'success');
            closedatatopuppopupModal();
            加载云更新数据(云更新管理_当前页码);
        } else {
            alert(result.message || '充值失败', false);
        }
    } catch (error) {
        alert('充值失败：' + error.message, false);
    }
}